[Unit]
Description=Aggiornamento automatico di MoscoRun (attivo solo con MOSCORUN_AUTO_UPDATE=1 in .env)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Percorso di installazione: adeguare se diverso.
WorkingDirectory=/opt/moscorun
ExecStart=/opt/moscorun/moscorun.sh auto-update
TimeoutStartSec=15min
