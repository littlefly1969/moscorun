@@EDGE_REALIP@@
    add_header Strict-Transport-Security $moscorun_hsts always;
@@EXTRA_HEADERS@@
    # Le API ricevono solo JSON piccoli.
    client_max_body_size 1m;

    # Rinnovo dei certificati con "certbot certonly --webroot -w @@ACME_ROOT@@".
    location ^~ /.well-known/acme-challenge/ {
        root @@ACME_ROOT@@;
        default_type text/plain;
    }

    location / {
        proxy_pass http://127.0.0.1:@@APP_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              @@PUBLIC_HOST@@;
        proxy_set_header X-Forwarded-Host  @@PUBLIC_HOST@@;
        proxy_set_header X-Forwarded-Proto $moscorun_proto;
        # Un solo indirizzo, già verificato: niente $proxy_add_x_forwarded_for (catena manipolabile).
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_read_timeout 60s;
    }
