# Copiare in .env sul server e proteggere:  chmod 600 .env
# Non inserire valori reali in questo file di esempio né nel repository.

# --- Immagine ---
# Canale di aggiornamento: "latest" (ultima release), una major ("0") o una versione esatta ("0.2.1").
MOSCORUN_VERSION=latest
MOSCORUN_PORT=8085

# --- Database (vedi docs/deploy-linux.md, "Database") ---
# Predefinito e consigliato: database incluso nel compose, isolato da altre applicazioni del server.
# Le due righe vanno insieme ("./moscorun.sh check" verifica la coerenza).
COMPOSE_PROFILES=bundled-db
POSTGRES_HOST=db
# In alternativa, PostgreSQL di sistema sull'host: commentare COMPOSE_PROFILES e usare
#POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=moscorun
POSTGRES_USER=moscorun
# Generare con:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=Prefer

# --- Primo avvio: amministratore creato da "moscorun.sh update" se non esistono utenti ---
# Dopo il primo accesso si possono svuotare.
MOSCORUN_ADMIN_EMAIL=
# Almeno 12 caratteri, con maiuscola, minuscola e cifra, senza parole segnaposto come "password" o "example"
# (verificato da "./moscorun.sh check").
MOSCORUN_ADMIN_PASSWORD=

# --- Backup automatico prima di ogni aggiornamento ---
# Cartella scrivibile dall'utente che esegue moscorun.sh (verificato da "./moscorun.sh check"), ad esempio:
#   sudo install -d -m 700 -o "$USER" -g "$USER" /var/backups/moscorun
MOSCORUN_BACKUP_DIR=/var/backups/moscorun
MOSCORUN_BACKUP_KEEP=14

# --- Aggiornamento automatico (timer systemd) ---
# Lasciare 0 finché aggiornamento, rollback, backup e ripristino non sono stati verificati su questo server.
MOSCORUN_AUTO_UPDATE=0

# --- Reverse proxy: "./moscorun.sh proxy-config nginx" genera la configurazione da questi valori ---
MOSCORUN_PUBLIC_HOST=
# 1 = nginx termina l'HTTPS (consigliato); 0 = HTTP, con l'HTTPS terminato da un proxy di frontiera.
MOSCORUN_PROXY_TLS=0
#MOSCORUN_PROXY_HTTP3=0
# Proxy di frontiera fidati (IP o CIDR), es. un Apache su un'altra macchina. Vuoto = nessuno.
MOSCORUN_EDGE_PROXIES=
#MOSCORUN_TLS_CERT=/etc/letsencrypt/live/<host>/fullchain.pem
#MOSCORUN_TLS_KEY=/etc/letsencrypt/live/<host>/privkey.pem
#MOSCORUN_ACME_ROOT=/var/www/letsencrypt
#MOSCORUN_PROXY_LISTEN=80
#MOSCORUN_PROXY_TLS_LISTEN=443
# Solo per generare il virtual host della frontiera ("proxy-config apache"): nginx visto dalla frontiera.
#MOSCORUN_PROXY_UPSTREAM=http://192.0.2.20

# --- Mappe dei percorsi (facoltativo) ---
# Chiave "Maps JavaScript API" per il cruscotto web, diversa da quella dell'app Android. Nella console Google Cloud
# limitarla a "Siti web" con referrer https://<MOSCORUN_PUBLIC_HOST>/* e alla sola Maps JavaScript API.
# Vuota = nessuna cartografia: il percorso è disegnato senza mappa di sfondo e nessuna richiesta va a Google.
MOSCORUN_GOOGLE_MAPS_API_KEY=
# "google" o "none"; vuoto = google se la chiave è presente.
#MOSCORUN_MAPS_PROVIDER=

# --- Zone private (facoltativo, spente per impostazione predefinita) ---
# Partenza e arrivo dentro questi cerchi non vengono mostrati: "latitudine,longitudine,raggio_in_metri" separati da ";".
# Raggio tra 50 e 5000 m. Il dato salvato resta completo.
#MOSCORUN_PRIVACY_ZONES=41.9000,12.5000,300

# --- Rete Docker ---
# Il reverse proxy sull'host raggiunge il container tramite il gateway di questa rete: è l'unico proxy fidato per
# X-Forwarded-*. Cambiare la subnet solo se è già usata sul server.
#MOSCORUN_SUBNET=172.30.85.0/24
#MOSCORUN_GATEWAY=172.30.85.1

# --- Generato automaticamente da "moscorun.sh update" ---
# MOSCORUN_DATA_PROTECTION_CERT: certificato che cifra le chiavi dei cookie nel database.
# Conservare una copia di questo file .env in un luogo sicuro: senza il certificato, dopo un ripristino
# su un altro server bisogna solo rifare l'accesso (i dati non dipendono da questa chiave).
