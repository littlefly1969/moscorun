# Copiare in .env sul server e proteggere:  chmod 600 .env
# Non inserire valori reali in questo file di esempio né nel repository.

# --- Immagine ---
# Canale di aggiornamento: "latest" (ultima release), una major ("0") o una versione esatta ("0.2.1").
MOSCORUN_VERSION=latest
MOSCORUN_PORT=8085

# --- Database: istanza PostgreSQL esistente ---
# PostgreSQL con porta pubblicata sull'host:  POSTGRES_HOST=host.docker.internal
# Database incluso nel compose:               COMPOSE_PROFILES=bundled-db  e  POSTGRES_HOST=db
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=moscorun
POSTGRES_USER=moscorun
# Generare con:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=Prefer
#COMPOSE_PROFILES=bundled-db

# --- Primo avvio: amministratore creato da "moscorun.sh update" se non esistono utenti ---
# Dopo il primo accesso si possono svuotare.
MOSCORUN_ADMIN_EMAIL=
# Almeno 12 caratteri.
MOSCORUN_ADMIN_PASSWORD=

# --- Backup automatico prima di ogni aggiornamento ---
MOSCORUN_BACKUP_DIR=/var/backups/moscorun
MOSCORUN_BACKUP_KEEP=14
