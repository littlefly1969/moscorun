{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    { "type": "feat", "section": "Novità" },
    { "type": "fix", "section": "Correzioni" },
    { "type": "perf", "section": "Prestazioni" },
    { "type": "security", "section": "Sicurezza" },
    { "type": "docs", "section": "Documentazione" },
    { "type": "deps", "section": "Dipendenze" },
    { "type": "refactor", "section": "Manutenzione", "hidden": true },
    { "type": "test", "section": "Test", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Varie", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "moscorun",
      "extra-files": [
        { "type": "generic", "path": "backend/Directory.Build.props" },
        { "type": "json", "path": "web/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
