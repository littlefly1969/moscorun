{
  "name": "MoscoRun Android (JDK 17)",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "postCreateCommand": "bash .devcontainer/setup-android.sh",
  "customizations": { "vscode": { "extensions": ["fwcd.kotlin", "redhat.java"] } },
  "remoteEnv": { "ANDROID_HOME": "/home/vscode/.local/share/android-sdk" }
}
